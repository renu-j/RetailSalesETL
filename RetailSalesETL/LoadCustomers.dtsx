          SQLTask:SqlStatementSource="INSERT INTO dbo.AuditLog&#xA;(&#xA;    PackageName,&#xA;    SourceFile,&#xA;    StartTime,&#xA;    Status,&#xA;    RecordsRead,&#xA;    RecordsInserted,&#xA;    RecordsRejected&#xA;)&#xA;OUTPUT INSERTED.AuditID AS AuditID&#xA;VALUES&#xA;(&#xA;    'LoadCustomers.dtsx',&#xA;    'Customers.csv',&#xA;    GETDATE(),&#xA;    'Running',&#xA;    0,&#xA;    0,&#xA;    0&#xA;);"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
