        <SQLTask:SqlTaskData
          SQLTask:Connection="{12AD7B36-9583-4DAC-A73D-54C4BDD19E6B}"
          SQLTask:SqlStatementSource="UPDATE dbo.AuditLog&#xA;SET&#xA;    EndTime = GETDATE(),&#xA;    Status = 'Success',&#xA;    RecordsRead =&#xA;    (&#xA;        SELECT COUNT(*)&#xA;        FROM dbo.StgCustomer&#xA;    ),&#xA;    RecordsRejected =&#xA;    (&#xA;        SELECT COUNT(*)&#xA;        FROM dbo.RejectedRecords&#xA;        WHERE EntityType = 'Customer'&#xA;          AND SourceFile = 'Customers.csv'&#xA;          AND ErrorDate &gt;=&#xA;          (&#xA;              SELECT StartTime&#xA;              FROM dbo.AuditLog&#xA;              WHERE AuditID = ?&#xA;          )&#xA;    ),&#xA;    RecordsInserted =&#xA;    (&#xA;        SELECT COUNT(*)&#xA;        FROM dbo.StgCustomer&#xA;    )&#xA;    -&#xA;    (&#xA;        SELECT COUNT(*)&#xA;        FROM dbo.RejectedRecords&#xA;        WHERE EntityType = 'Customer'&#xA;          AND SourceFile = 'Customers.csv'&#xA;          AND ErrorDate &gt;=&#xA;          (&#xA;              SELECT StartTime&#xA;              FROM dbo.AuditLog&#xA;              WHERE AuditID = ?&#xA;          )&#xA;    )&#xA;WHERE AuditID = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
