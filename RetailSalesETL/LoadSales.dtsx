      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{12AD7B36-9583-4DAC-A73D-54C4BDD19E6B}"
          SQLTask:SqlStatementSource="UPDATE dbo.AuditLog&#xA;SET&#xA;    EndTime = GETDATE(),&#xA;    Status = 'Success',&#xA;    RecordsRead = (&#xA;        SELECT COUNT(*)&#xA;        FROM dbo.StgSales&#xA;    ),&#xA;    RecordsInserted = (&#xA;        SELECT COUNT(*)&#xA;        FROM dbo.FactSales&#xA;        WHERE CONVERT(date, LoadDate) = CONVERT(date, GETDATE())&#xA;    ),&#xA;    RecordsRejected = (&#xA;        SELECT COUNT(*)&#xA;        FROM dbo.RejectedRecords&#xA;        WHERE EntityType = 'Sale'&#xA;          AND CONVERT(date, ErrorDate) = CONVERT(date, GETDATE())&#xA;    )&#xA;WHERE AuditID = (&#xA;    SELECT MAX(AuditID)&#xA;    FROM dbo.AuditLog&#xA;    WHERE PackageName = 'LoadSales.dtsx'&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
