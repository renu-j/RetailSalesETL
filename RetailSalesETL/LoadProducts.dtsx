          SQLTask:SqlStatementSource="UPDATE dbo.AuditLog&#xA;SET&#xA;    EndTime = GETDATE(),&#xA;    Status = 'Success',&#xA;    RecordsRead = (SELECT COUNT(*) FROM dbo.StgProduct),&#xA;    RecordsInserted = (&#xA;        SELECT COUNT(*)&#xA;        FROM dbo.DimProduct&#xA;        WHERE CONVERT(date, CreatedDate) = CONVERT(date, GETDATE())&#xA;    ),&#xA;    RecordsRejected = (&#xA;        SELECT COUNT(*)&#xA;        FROM dbo.RejectedRecords&#xA;        WHERE EntityType = 'Product'&#xA;          AND CONVERT(date, ErrorDate) = CONVERT(date, GETDATE())&#xA;    )&#xA;WHERE AuditID = (&#xA;    SELECT MAX(AuditID)&#xA;    FROM dbo.AuditLog&#xA;    WHERE PackageName = 'LoadProducts.dtsx'&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
