      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{12AD7B36-9583-4DAC-A73D-54C4BDD19E6B}"
          SQLTask:SqlStatementSource="UPDATE dbo.AuditLog&#xA;SET&#xA;    EndTime = GETDATE(),&#xA;    Status = 'Failed',&#xA;    ErrorMessage = 'Product ETL package failed.'&#xA;WHERE AuditID = (&#xA;    SELECT MAX(AuditID)&#xA;    FROM dbo.AuditLog&#xA;    WHERE PackageName = 'LoadProducts.dtsx'&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
