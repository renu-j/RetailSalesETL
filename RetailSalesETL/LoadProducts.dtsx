    StgProductID,
    NULLIF(LTRIM(RTRIM(ProductID)), '') AS CleanProductID,
    NULLIF(LTRIM(RTRIM(ProductName)), '') AS CleanProductName,
    Category,
    TRY_CONVERT(
        DECIMAL(12,2),
        NULLIF(LTRIM(RTRIM(Price)), '')
    ) AS PriceValue,
    SourceFile,
    LoadDate,
    ROW_NUMBER() OVER (
        PARTITION BY NULLIF(LTRIM(RTRIM(ProductID)), '')
        ORDER BY StgProductID
    ) AS ProductIDRowNumber
FROM dbo.StgProduct;</property>
