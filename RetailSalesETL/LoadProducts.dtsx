          SQLTask:SqlStatementSource="INSERT INTO dbo.AuditLog&#xA;(&#xA;    PackageName,&#xA;    SourceFile,&#xA;    StartTime,&#xA;    Status,&#xA;    RecordsRead,&#xA;    RecordsInserted,&#xA;    RecordsRejected&#xA;)&#xA;VALUES&#xA;(&#xA;    'LoadProducts.dtsx',&#xA;    'Products.csv',&#xA;    GETDATE(),&#xA;    'Running',&#xA;    0,&#xA;    0,&#xA;    0&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
