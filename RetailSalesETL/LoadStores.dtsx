      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{12AD7B36-9583-4DAC-A73D-54C4BDD19E6B}"
          SQLTask:SqlStatementSource="UPDATE dbo.AuditLog&#xA;SET&#xA;    EndTime = GETDATE(),&#xA;    Status = 'Failed',&#xA;    ErrorMessage = 'Store ETL package failed.'&#xA;WHERE AuditID = (&#xA;    SELECT MAX(AuditID)&#xA;    FROM dbo.AuditLog&#xA;    WHERE PackageName = 'LoadStores.dtsx'&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Audit_Start"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{079354c8-8344-4b50-a75f-5dbfcc1c5e01}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Audit_Start"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{12AD7B36-9583-4DAC-A73D-54C4BDD19E6B}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.AuditLog&#xA;(&#xA;    PackageName,&#xA;    SourceFile,&#xA;    StartTime,&#xA;    Status,&#xA;    RecordsRead,&#xA;    RecordsInserted,&#xA;    RecordsRejected&#xA;)&#xA;VALUES&#xA;(&#xA;    'LoadStores.dtsx',&#xA;    'Stores.csv',&#xA;    GETDATE(),&#xA;    'Running',&#xA;    0,&#xA;    0,&#xA;    0&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Audit_Success"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{df7fdc13-718c-4f4b-95eb-7da2992e1699}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Audit_Success"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{12AD7B36-9583-4DAC-A73D-54C4BDD19E6B}"
          SQLTask:SqlStatementSource="UPDATE dbo.AuditLog&#xA;SET&#xA;    EndTime = GETDATE(),&#xA;    Status = 'Success',&#xA;    RecordsRead = (SELECT COUNT(*) FROM dbo.StgStore),&#xA;    RecordsInserted = (SELECT COUNT(*) FROM dbo.DimStore),&#xA;    RecordsRejected = (&#xA;        SELECT COUNT(*)&#xA;        FROM dbo.RejectedRecords&#xA;        WHERE EntityType = 'Store'&#xA;          AND CONVERT(date, ErrorDate) = CONVERT(date, GETDATE())&#xA;    )&#xA;WHERE AuditID = (&#xA;    SELECT MAX(AuditID)&#xA;    FROM dbo.AuditLog&#xA;    WHERE PackageName = 'LoadStores.dtsx'&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
